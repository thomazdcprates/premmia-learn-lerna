{
  "name": "premmia-learn-lerna",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^30.2.0",
    "lerna": "^8.1.0",
    "ts-jest": "^29.4.5",
    "typescript": "^5.6.3"
  },
  "scripts": {
    "build": "lerna run build",
    "clean": "rm -rf node_modules packages/**/node_modules packages/**/dist",
    "publish-package": "lerna publish --contents dist",
    "test": "lerna run test"
  }
}
